{
  "$schema": "https://opencode.ai/config.json",

  // Default model – OpenCode Zen (no API key required)
  // Switch with /model command inside Ultron
  "model": "opencode/nemotron-3-super-free",
  "default_agent": "ultron",

  // small_model: used for title generation
  "small_model": "groq/llama-3.1-8b-instant",

  // ── Compaction agent: uses a high-context model to summarize long sessions.
  // google/gemini-2.0-flash-001 via OpenRouter = 1,048,576 token context (1M).
  // This prevents "Conversation history too large to compact" on very long sessions.
  "agent": {
    "compaction": {
      "model": "openrouter/google/gemini-2.0-flash-001"
    },
    "title": {
      "model": "groq/llama-3.1-8b-instant"
    }
  },

  // ── Providers: free/Zen + Groq (fast inference) + OpenRouter (1M-ctx models)
  "enabled_providers": [
    "opencode",
    "zenmux",
    "groq",
    "openrouter"
  ],

  "provider": {
    "groq": {
      // Fallback key chain: tries GROQ_API_KEY first, falls back to GROQ_API_KEY_2
      "env": ["GROQ_API_KEY", "GROQ_API_KEY_2"],
      // Pin a sane default ordering so picker shows best models first
      "models": {
        "openai/gpt-oss-120b":           { "status": "alpha" },
        "openai/gpt-oss-20b":            { "status": "alpha" },
        "openai/gpt-oss-safeguard-20b":  { "status": "alpha" },
        "canopylabs/orpheus-v1-english":  { "status": "alpha" },
        "canopylabs/orpheus-arabic-saudi": { "status": "alpha" },
        "meta-llama/llama-prompt-guard-2-22m": { "status": "alpha" },
        "meta-llama/llama-prompt-guard-2-86m": { "status": "alpha" },
        "meta-llama/llama-guard-4-12b":   { "status": "alpha" },
        "llama-guard-3-8b":               { "status": "alpha" },
        "whisper-large-v3":               { "status": "alpha" },
        "whisper-large-v3-turbo":         { "status": "alpha" }
      }
    }
  },

  "instructions": [".opencode/ULTRON_MEMORY.md"],
  "skills": {
    "paths": ["C:/Users/moezf/Desktop/Claude-Skills"]
  },

  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },

  "mcp": {
    // Browser automation (Playwright) – globally installed
    "browser": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/playwright-mcp.cmd", "--headless"]
    },
    // Desktop control – servo-mcp (desktop-commander dist was missing)
    "desktop": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/servo-mcp.cmd"]
    },
    // File system access – globally installed cmd wrapper
    "filesystem": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/mcp-server-filesystem.cmd", "C:/Users/moezf/Desktop"]
    },
    // Persistent memory – globally installed cmd wrapper
    "memory": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/mcp-server-memory.cmd"]
    },
    // Ultron Swarm – multi-agent task routing
    "swarm": {
      "type": "local",
      "command": [
        "C:/Users/moezf/Desktop/opencode/swarm/venv/Scripts/python.exe",
        "C:/Users/moezf/Desktop/opencode/swarm/mcp_server.py"
      ]
    },
    // TaskSync – pause and ask Moez when stuck
    "tasksync": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Local/Python/bin/python3.exe", "C:/Users/moezf/Desktop/opencode/.opencode/mcp/tasksync.py"]
    }
  },

  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}