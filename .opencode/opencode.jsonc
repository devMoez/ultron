{
  "$schema": "https://opencode.ai/config.json",

  // ─────────────────────────────────────────────────────────────────
  //  FREE MODELS (OpenCode Zen) – no API key required
  //  Available: @cf/meta/llama-3.3-70b-instruct-fp8-fast (default),
  //            nemotron, minimax, qwen, gemma, etc.
  //  Switch with /model command inside OpenCode
  // ─────────────────────────────────────────────────────────────────
  "model": "cloudflare-workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast",

  "provider": {
    // Cloudflare Workers AI – free tier (included in OpenCode Zen)
    "cloudflare-workers-ai": {
      // No API key needed for Zen models – uses OpenCode's internal free quota
    },
    // DeepSeek – keep your API key for when you need the reasoner or faster responses
    "deepseek": {
      "apiKey": "{env:DEEPSEEK_API_KEY}"
    }
  },

  "instructions": [".opencode/ULTRON_MEMORY.md"],
  "skills": {
    "paths": ["C:/Users/moezf/Desktop/Claude-Skills"]
  },

  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },

  "mcp": {
    // Browser automation (Playwright) – globally installed
    "browser": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/playwright-mcp.cmd", "--headless"]
    },
    // Desktop control – globally installed cmd wrapper
    "desktop": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/desktop-commander.cmd"]
    },
    // File system access – globally installed cmd wrapper
    "filesystem": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/mcp-server-filesystem.cmd", "C:/Users/moezf/Desktop"]
    },
    // Persistent memory – globally installed cmd wrapper
    "memory": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Roaming/npm/mcp-server-memory.cmd"]
    },
    // Ultron Swarm – multi-agent task routing
    "swarm": {
      "type": "local",
      "command": [
        "C:/Users/moezf/Desktop/opencode/swarm/venv/Scripts/python.exe",
        "C:/Users/moezf/Desktop/opencode/swarm/mcp_server.py"
      ]
    },
    // TaskSync – pause and ask Moez when stuck
    "tasksync": {
      "type": "local",
      "command": ["C:/Users/moezf/AppData/Local/Python/bin/python3.exe", "C:/Users/moezf/Desktop/opencode/.opencode/mcp/tasksync.py"]
    }
  },

  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}