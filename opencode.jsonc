{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/meta-llama/llama-3.3-70b-instruct:free",
  "provider": {
    "openrouter": {
      "apiKey": "sk-or-v1-..."
    },
    "groq": {
      "apiKey": "gsk-..."
    }
  },
  "instructions": [".opencode/ULTRON_MEMORY.md"],
  "skills": {
    "paths": ["C:/Users/moezf/Desktop/Claude-Skills"]
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "mcp": {
    "browser": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"]
    },
    "desktop": {
      "type": "local",
      "command": ["python3", "C:/Users/moezf/Desktop/opencode/.opencode/mcp/desktop.py"]
    },
    "tasksync": {
      "type": "local",
      "command": ["python3", "C:/Users/moezf/Desktop/opencode/.opencode/mcp/tasksync.py"]
    },
    "cortex": {
      "type": "local",
      "command": ["python", "C:/Users/moezf/Desktop/Cortex/mcp_server.py"]
    },
    "swarm": {
      "type": "local",
      "command": ["C:/Users/moezf/Desktop/opencode/swarm/venv/Scripts/python.exe", "-m", "uvicorn", "orchestrator:app", "--port", "8000"]
    },
    "true-swarm": {
      "type": "local",
      "command": ["C:/Users/moezf/Desktop/opencode/swarm/venv/Scripts/python.exe", "-m", "uvicorn", "orchestrator:app", "--port", "8000"]
    },
    "memory": {
      "type": "local",
      "command": ["python3", "C:/Users/moezf/Desktop/opencode/memory/memory_mcp.py"]
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
